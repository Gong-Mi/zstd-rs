--- /dev/null
+++ b/ruzstd/src/sme_copy.rs
@@ -0,0 +1,54 @@
+//! Experimental hook: hand-written streaming-SME ("SME") bulk copy, called over
+//! the C ABI. Rust nightly has no SME intrinsics (feature `stdarch_aarch64_sme`
+//! does not exist), so the wide copy lives in `sme/ruzstd_sme_copy.c` and is
+//! linked as a static library for the on-device experiment.
+//!
+//! Gate: `RUZSTD_SME_MIN=<bytes>` (read once per process). Unset/0 = disabled,
+//! i.e. this module is inert unless the environment asks for it, so the same
+//! binary can be used for A/B.
+
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+const UNINIT: usize = usize::MAX;
+const DISABLED: usize = usize::MAX - 1;
+
+static THRESHOLD: AtomicUsize = AtomicUsize::new(UNINIT);
+
+extern "C" {
+    fn ruzstd_sme_copy(dst: *mut u8, src: *const u8, n: usize);
+}
+
+#[cold]
+fn init() {
+    let v = std::env::var("RUZSTD_SME_MIN")
+        .ok()
+        .and_then(|s| s.parse::<usize>().ok())
+        .unwrap_or(0);
+    THRESHOLD.store(if v == 0 { DISABLED } else { v }, Ordering::SeqCst);
+}
+
+#[inline(always)]
+fn threshold() -> usize {
+    let t = THRESHOLD.load(Ordering::Relaxed);
+    if t == UNINIT {
+        init();
+        THRESHOLD.load(Ordering::Relaxed)
+    } else {
+        t
+    }
+}
+
+/// Copy `len` bytes with the streaming-SME kernel when it is enabled and the
+/// transfer is at least as large as the configured threshold.
+///
+/// # Safety
+/// `dst`/`src` must be valid for `len` bytes and must not overlap.
+#[inline(always)]
+pub(crate) unsafe fn try_copy(dst: *mut u8, src: *const u8, len: usize) -> bool {
+    if len >= threshold() {
+        ruzstd_sme_copy(dst, src, len);
+        true
+    } else {
+        false
+    }
+}
